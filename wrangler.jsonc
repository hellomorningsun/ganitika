{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mathesis-teacher",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  // The teacher app's own address. ganitika.org must be in the same Cloudflare account.
  "routes": [{ "pattern": "teach.ganitika.org", "custom_domain": true }],
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mathesis",
      // Replace with the id printed by `npx wrangler d1 create mathesis`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
